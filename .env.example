# Copy to .env and fill in. docker-compose.yml passes these to the VS Code container.

# TiDB Cloud Starter cluster (Connect button in the TiDB Cloud console)
SERVERLESS_CLUSTER_HOST=
SERVERLESS_CLUSTER_PORT=4000
SERVERLESS_CLUSTER_USERNAME=
SERVERLESS_CLUSTER_PASSWORD=
SERVERLESS_CLUSTER_DATABASE_NAME=test

# AWS account with Bedrock access to amazon.titan-embed-text-v2:0 and us.amazon.nova-pro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION_NAME=us-east-1
# Optional: an application inference profile ARN, to track costs
BEDROCK_MODEL_ID=

# Local MySQL for rag.py and improved_rag.py
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mydatabase
